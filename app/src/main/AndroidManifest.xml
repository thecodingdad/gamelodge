<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runs on handhelds, phones, tablets and TVs alike. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Reading the Wi-Fi name (SSID) for "connect VPN outside home Wi-Fi" requires location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- System brightness slider in the quick menu (granted by the user in system settings). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Number of connected Bluetooth devices in the quick menu (Android 12+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Package visibility (Android 11+): list every launchable app for the library. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:label="@string/launcher_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/atv_banner"
        android:localeConfig="@xml/locales_config"
        tools:replace="android:name,android:localeConfig">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MoonlightLauncher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher mode: enabled at runtime from Settings -> Launcher mode. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Artemis' host list stays reachable from inside the launcher, but must not
             show up as a second icon in the app drawer. -->
        <activity
            android:name="com.limelight.PcView"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
    </application>
</manifest>
