<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runs on handhelds, phones, tablets and TVs alike. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Reading the Wi-Fi name (SSID) for "connect VPN outside home Wi-Fi" requires location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- System brightness slider in the quick menu (granted by the user in system settings). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Play time of local apps/games from Android's usage statistics (granted by the user in settings). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Optional quick menu handle at the screen edge above other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Hand the input focus back to the launcher on the TV (multi-display). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Optional for emulation: read ROM folders directly and find ES-DE covers (granted by the user). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Number of connected Bluetooth devices in the quick menu (Android 12+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Quick menu tiles: "Do not disturb" and silent mode. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Package visibility (Android 11+): list every launchable app for the library. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- AYN Odin: controller takeover of the touch-mapping service (see OdinMapping). -->
        <package android:name="com.odin.mapping" />
    </queries>

    <application
        android:name=".LauncherApplication"
        android:label="@string/launcher_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/atv_banner"
        android:localeConfig="@xml/locales_config"
        tools:replace="android:name,android:localeConfig">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MoonlightLauncher"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick menu as an overlay above other apps and the stream (own task). -->
        <!-- Handheld screen (controller, touchpad, black) while the launcher runs on a TV. -->
        <activity
            android:name=".PhoneScreenActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.phonescreen"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />
        <activity
            android:name=".QuickMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.MoonlightLauncher.Overlay"
            android:taskAffinity="${applicationId}.quickmenu"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- Launcher mode: enabled at runtime from Settings -> Launcher mode. -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Artemis' host list stays reachable from inside the launcher, but must not
             show up as a second icon in the app drawer. -->
        <activity
            android:name="com.limelight.PcView"
            android:exported="false"
            tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <!-- Optional: system-wide controller button combinations (Home, quick menu). -->
        <service
            android:name=".system.QuickMenuTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_menu"
            android:label="@string/quick_menu"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".input.ComboAccessibilityService"
            android:exported="true"
            android:label="@string/combo_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/combo_accessibility_service" />
        </service>
    </application>
</manifest>
