    android:insetLeft="24dp" android:insetRight="24dp" android:insetTop="24dp" android:insetBottom="24dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/launcher_surface" />
        <corners android:radius="24dp" />
    </shape>
</inset>
