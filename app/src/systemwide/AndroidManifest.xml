<?xml version="1.0" encoding="utf-8"?>
<!-- Systemwide edition: the accessibility service for button combinations in every app. Left out of
     the standard edition, whose file install Play Protect would block because of it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".input.ComboAccessibilityService"
            android:exported="true"
            android:label="@string/combo_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/combo_accessibility_service" />
        </service>
    </application>
</manifest>
